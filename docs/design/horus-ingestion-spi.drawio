    <mxCell id="NOTE" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=#999999;dashed=1;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;THE LOAD SEQUENCE&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;1. operator asserts sourceId + formatId&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;2. FixtureVerifier runs first &#8212; fail fast&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;3. stream &#8594; RawRecord &#8594; CanonicalRecord&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;4. CapabilityDeriver counts on the same pass&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;5. CapabilityGate: actual vs expectation&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;6. within tolerance &#8594; promote&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;7. outside &#8594; halt, operator confirms&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:10px;&quot;&gt;Certainty comes from measurement at the END,&lt;br/&gt;not from knowledge at the start (&#167;13.3).&lt;/p&gt;" vertex="1">
      <mxGeometry height="230" width="290" x="1240" y="1500" as="geometry" />
    </mxCell>
